# ============================================================
# BD Cheap SMM - Environment Configuration
# Copy this file to .env.local and fill in the values.
# Never commit the real .env.local file.
# ============================================================

# ---------- Supabase (client + server) ----------
# Find these in your Supabase project: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: Project Settings > API > service_role.
# Server only. NEVER exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- SMM Provider API ----------
# The provider API key is used server-side only.
# Provider endpoints & keys are also configurable per-provider in the
# Admin Panel (Admin > Providers). These env vars serve as the default
# values used when seeding/configuring a provider.
SMM_PROVIDER_API_URL=https://smmfollows.com/api/v2
SMM_PROVIDER_API_KEY=your-provider-api-key

# ---------- App ----------
# The public base URL of the application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Rate limiting (Upstash Redis) ----------
# Optional. If empty, an in-memory rate limiter is used (per server instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Scheduled jobs (Vercel Cron) ----------
# Used by /api/cron/order-status to poll provider order statuses.
# Must be set to your Vercel Cron secret in production.
CRON_SECRET=your-cron-secret
